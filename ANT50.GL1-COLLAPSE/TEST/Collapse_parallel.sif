!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
include elmer.param
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
Header
  Mesh DB "." "MSH.P2"
End
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
Constants
   Sea Level = Real $zsl
   Water Density = Real $rhow
End
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
Simulation

  Coordinate System  = Cartesian 2D
  
  Simulation Type = Transient
  Timestepping Method = "bdf"
  BDF Order = 1

  Timestep Intervals = 250
  TimeStep Sizes =  1
  Output Intervals = 10


  Steady State Max Iterations = 1
  Steady State Min Iterations = 1

  max output level = 10
End

!%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
Body 1
  Equation = 1
  Initial Condition = 1
  Body Force = 1
  Material = 1
End

!#####
Body Force 1

 ! Thickness to 1 meter if collapse
 !h = Variable CollapseMask
 !   REAL LUA "h "


End
!#####
Material 1
  SSA Mean Density = Real $rhoi
End
!#####
!###################################################
!### Read h
!###################################################
Solver 1
  Exec Solver = String "Before Simulation"
  Equation = Eq1
  Procedure = "ElmerIceSolvers" "UGridDataReader"

  File Name = File "MSH.P2/restart_000.nc"

  Time Index = Integer -1

!# Time variable inputs
   !# geometry
   Variable Name 1 = File "h"
   Variable Name 2 = File "zs"
   Variable Name 3 = File "zb"
   Variable Name 4 = File "haf"
   Variable Name 5 = File "groundedmask"

   !# ssa velocity
   Variable Name 6 = File "ssavelocity 1"
   Variable Name 7 = File "ssavelocity 2"

!# Constant inputs
   !# Nodal inputs
   Variable Name 8  = File "bedrock"
   Variable Name 9  = File "mueta2"

   !# Time
   Variable Name 10 = File "elmer_time"
   Target Variable 10 = String "time"

!# Export Constant inputs to feed next restart
   Exported Variable 1 = bedrock
   Exported Variable 2 = mueta2
   Exported Variable 3 = h
   Exported Variable 4 = -dofs 2 "ssavelocity"
End


Solver 2
  Exec Solver= Before Timestep
   Equation = "Fracture_mask_reader"
   Procedure = "ElmerIceSolvers" "UGridDataReader"

   Is Time Counter = Logical True
   Time Counter start = Integer 50

   File Name = File "./UGRID_Fracture/Fracture_Mask_2000-2299.nc"
   Variable Name 1 = File "fracture_mask"
   Exported Variable 1 = -elem fracture_mask
   Update Exported Variables = Logical True
End

Solver 3
   Exec Solver= Before Timestep
   Equation = "CollapseAreas"
   Variable = -dofs 1 dummy
   Procedure = "CollapseAreas" "CollapseAreas"

   Optimize Bandwidth = False

  Fracture Variable = String "fracture_mask"
  
  Collapse Ratio = Real 0.6
  Shelf Lower Limit for Collapse = Real 2e7

  ! Optional thickness update in collapsed regions:
  ! none | passive | minimum | factor
  Collapse Thickness Mode = String "factor"
  Collapse Thickness Factor = Real 0.8
  ! Collapse Min Thickness = Real 1.0

  File Name = File "output_collapse.txt"
  
  Exported Variable 1 = -dofs 1 h
End


Solver 4
  Equation = "Dumy"
  procedure = "ElmerIceSolvers" "UpdateExport"
  variable = -nooutput  dumy2

  !Exported Variable 1 = -dofs 1 h
End

Solver 5
  Exec Solver = String "after saving"
  Equation = String "ResultOutput"
  Procedure = File "ResultOutputSolve" "ResultOutputSolver"
  Save Geometry Ids = Logical True
  Output File Name = File "Collapse"
  Output Format = String "vtu"
  Output Directory = File "VTUs_Outputs"
  Vtu Format = Logical True
End

!#####
Equation 1
  Active Solvers(4)= 1 2 3 4 5
End

!#####
Boundary Condition 1
  Target Boundaries = 1
End


